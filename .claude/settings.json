{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai/runtime/claude-code/hooks/usage-guard.sh refresh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai/runtime/claude-code/hooks/usage-guard.sh inform"
          },
          {
            "type": "command",
            "command": "bash .compound-ai/runtime/claude-code/hooks/session-router.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai-local/runtime/claude-code/hooks/context-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai-local/runtime/claude-code/hooks/workspace-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai-local/runtime/claude-code/hooks/usage-guard.sh check",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai/runtime/claude-code/hooks/usage-guard.sh block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .compound-ai-local/runtime/claude-code/hooks/usage-guard.sh count",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
